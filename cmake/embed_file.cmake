# Embeds a file into a C++ translation unit as `gufo::server::kDashboardHtml`.
# Usage: cmake -DINPUT=<file> -DOUTPUT=<generated.cpp> -P cmake/embed_file.cmake
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "embed_file.cmake requires -DINPUT and -DOUTPUT")
endif()
if(NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "embed_file.cmake: input '${INPUT}' does not exist")
endif()

file(READ "${INPUT}" data HEX)
string(LENGTH "${data}" hex_length)
math(EXPR byte_count "${hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${data}")

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}"
  "// Generated by cmake/embed_file.cmake from ${INPUT} - do not edit.\n"
  "#include \"src/cli/serve/dashboard_html.hpp\"\n\n"
  "namespace gufo::server {\n\n"
  "const unsigned char kDashboardHtml[] = {${bytes}0x00};\n"
  "const unsigned long kDashboardHtmlSize = ${byte_count}UL;\n\n"
  "}  // namespace gufo::server\n")
